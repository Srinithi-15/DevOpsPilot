# ==============================================================================
# DevOpsPilot - Environment Variables Template
# ==============================================================================
# Copy this file to .env before running services:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit real .env files with production credentials to source control.
# - This project runs on a ₹0 budget using local Docker containers.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (MySQL 8.0)
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=devopspilot_db
MYSQL_USER=devopspilot_user
MYSQL_PASSWORD=devopspilot_password
MYSQL_ROOT_PASSWORD=devopspilot_root_password

# ------------------------------------------------------------------------------
# 2. Backend Application Configuration (Spring Boot 3 + Java 21)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus,metrics

# ------------------------------------------------------------------------------
# 3. Observability & Monitoring Stack
# ------------------------------------------------------------------------------
# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ------------------------------------------------------------------------------
# 4. Frontend Application Configuration (React + Vite)
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
